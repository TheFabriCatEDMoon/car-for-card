{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flash (OpenOCD)",
            "detail": "用 CMSIS-DAP 把 build/Debug/2.1_Car_Test_C8_MX.elf 烧进 STM32F103C8，校验后复位运行",
            "type": "shell",
            "command": "D:\\openocd\\xpack-openocd-0.12.0-7\\bin\\openocd.exe",
            "args": [
                "-s", "D:\\openocd\\xpack-openocd-0.12.0-7\\openocd\\scripts",
                "-f", "interface/cmsis-dap.cfg",
                "-c", "transport select swd",
                "-f", "target/stm32f1x.cfg",
                "-c", "adapter speed 500",
                "-c", "program build/Debug/2.1_Car_Test_C8_MX.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
